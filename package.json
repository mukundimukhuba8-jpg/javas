{
  "name": "zero",
  "version": "0.1.0",
  "private": true,
  "description": "Zero \u2014 production-ready personal AI desktop assistant",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "zero": "pnpm build && tsx scripts/zero.ts",
    "preview:web": "pnpm --filter @zero/preview start",
    "build": "pnpm -r --filter './packages/*' --filter './services/*' --filter './apps/*' run build",
    "dev": "pnpm build && tsx scripts/zero.ts --dev",
    "typecheck": "pnpm -r --filter './packages/*' --filter './services/*' --filter './apps/*' run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@zero/agent": "workspace:*",
    "@zero/config": "workspace:*",
    "@zero/desktop": "workspace:*",
    "@zero/memory": "workspace:*",
    "@zero/shared": "workspace:*",
    "@zero/tools": "workspace:*",
    "@zero/ui": "workspace:*",
    "@zero/voice": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  },
  "type": "module"
}
