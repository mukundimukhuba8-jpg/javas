# Zero — Environment Variables
# Copy to .env and fill in values. Never commit secrets.
# Phase 1 validates shape; integrations are stubs until later phases.

NODE_ENV=development

# ── Anthropic (brain) ──────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=8192
AGENT_MAX_ITERATIONS=12
AGENT_MAX_RETRIES=2

# ── Voice: STT ─────────────────────────────────────────────────
DEEPGRAM_API_KEY=
# Optional local Whisper path (Phase 3)
WHISPER_MODEL_PATH=

# ── Voice: TTS ─────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Fallback TTS
FISH_AUDIO_API_KEY=

# ── Wake word (Porcupine / openWakeWord) ───────────────────────
PORCUPINE_ACCESS_KEY=
WAKE_WORD_ENGINE=porcupine

# ── Messaging ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Google (Calendar, Gmail, Sheets, Ads) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Meta Ads ───────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ── CRM / Knowledge ────────────────────────────────────────────
NOTION_API_KEY=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ── Email ──────────────────────────────────────────────────────
RESEND_API_KEY=
GMAIL_USER=

# ── Research ───────────────────────────────────────────────────
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ── Cal.com ────────────────────────────────────────────────────
CALCOM_API_KEY=

# ── Memory ─────────────────────────────────────────────────────
SQLITE_PATH=./memory/sqlite/zero.db
VECTOR_DB_PATH=./memory/vectors
VECTOR_DB_PROVIDER=lancedb

# ── Oracle / Supabase (publishable only in the web bundle) ─────
# Secret key stays in CI / local gitignored env — never EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
EXPO_PUBLIC_ORACLE_SYNC_EMAIL=
EXPO_PUBLIC_ORACLE_SYNC_PASSWORD=
# Optional — apply SQL migrations (scripts/apply-supabase-schema.mjs)
# SUPABASE_DB_PASSWORD=
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_SECRET_KEY=   # server-side prove / Storage mirror only

# ── Whop (server-only on Vercel — never EXPO_PUBLIC_ for secrets) ──
# Dashboard → Developer → API keys / Webhooks
# WHOP_API_KEY=           # Account API key (Bearer) — member:basic:read + member:email:read
# WHOP_COMPANY_ID=biz_…   # Company / account id (also accepted as WHOP_ACCOUNT_ID)
# WHOP_PLAN_ID=plan_HXXGXZqh48JQs
# WHOP_WEBHOOK_SECRET=ws_…  # From Create webhook (shown once)
# Optional public verify base for GitHub Pages clients pointing at Vercel:
# EXPO_PUBLIC_WHOP_VERIFY_URL=https://YOUR_VERCEL_APP.vercel.app/api/whop/verify

# ── Desktop ────────────────────────────────────────────────────
ZERO_HUD_TRANSPARENT=true
ZERO_ALWAYS_ON=true
ZERO_LOG_LEVEL=info
