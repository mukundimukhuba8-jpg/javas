# Oracle mobile — public Expo embeds only. Never put SUPABASE_SECRET_KEY here.
# Copy to .env (gitignored) or set in Vercel / CI for web export.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Sync account for Auth-metadata catalog when oracle_catalog table is not yet applied.
# Same tradeoff as permissive RLS on a private portal: anyone with the web bundle can R/W.
EXPO_PUBLIC_ORACLE_SYNC_EMAIL=
EXPO_PUBLIC_ORACLE_SYNC_PASSWORD=

# Optional: when the app is hosted on GitHub Pages (no /api), point at Vercel verify:
# EXPO_PUBLIC_WHOP_VERIFY_URL=https://YOUR_VERCEL_APP.vercel.app/api/whop/verify
# Whop secrets (WHOP_API_KEY, WHOP_COMPANY_ID, WHOP_WEBHOOK_SECRET) stay on Vercel only.
